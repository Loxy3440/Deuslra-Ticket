# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=
# Sunucu ID'si (Discord'da Geliştirici Modu açıkken sunucuya sağ tık > ID'yi kopyala)
DISCORD_GUILD_ID=

# Web panelinin giriş şifresi (boş bırakırsan yönetim paneli kapalı kalır)
# Render'da panel internete açık olur: en az 12 karakter, tahmin edilemez bir şifre koy.
PANEL_PASSWORD=
# Panel adresi: http://localhost:3000   (Render PORT'u kendisi verir, dokunma)
PORT=3000
HOST=127.0.0.1

# MongoDB Atlas bağlantı adresi (Render'da zorunlu; bilgisayarında boş bırakırsan yerel dosyalar kullanılır)
# Örnek: mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# İsteğe bağlı: veritabanı adı (varsayılan deuslra-destek)
MONGODB_DB=

# Ticket kayıtlarında (transcript) mesaj metinleri de görünsün istiyorsan:
# 1) Developer Portal > Bot > "Message Content Intent" anahtarını aç
# 2) Aşağıyı true yap
MESSAGE_CONTENT_INTENT=false
